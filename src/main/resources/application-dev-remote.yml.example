# 本地开发连接远程数据库
# 用法:
#   cp application-dev-remote.yml.example application-dev-remote.yml
#   mvn spring-boot:run -Dspring-boot.run.profiles=dev-remote
#
# application-dev-remote.yml 已在 .gitignore，勿提交密码

spring:
  datasource:
    url: jdbc:mysql://your-db-host:3306/light_diary?useUnicode=true&characterEncoding=utf-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: your_remote_mysql_password
  redis:
    host: your-redis-host
    port: 6379
    username:
    password: your_remote_redis_password
    database: 0
    timeout: 3000ms

logging:
  level:
    root: info
    com.lightdiary: debug

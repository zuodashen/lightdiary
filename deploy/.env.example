# 复制为 deploy/.env 后填写（.env 不要提交到 Git）
# cp deploy/.env.example deploy/.env

# Docker 网络（与 nginx、mysql 同一网络，docker inspect nginx 查看）
DOCKER_NETWORK=bridge

# MySQL（使用已有 mysql 容器，主机名填容器名）
MYSQL_HOST=mysql
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Redis（使用已有 redis 容器，主机名填容器名）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=root
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0

# JWT（生产请改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# 可选
KNIFE4J_ENABLE=false

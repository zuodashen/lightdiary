# 复制为 .env 后修改（不要提交 Git）
# cp .env.example .env

# 后端端口（宿主机 8080 已被 nginx 占用，lightdiary 用 8081）
SERVER_PORT=8081

# MySQL（mysql8 为 host 网络 → 127.0.0.1；若 ss 显示监听 13306 则改端口）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Redis（host 网络 → 127.0.0.1）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=root
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0

# JWT（生产请改为随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string
KNIFE4J_ENABLE=false

# 当 mysql / redis 使用 host 网络、lightdiary 使用 bridge 时的配置示例
# cp deploy/.env.bridge-host-db.example deploy/.env

DOCKER_NETWORK=bridge

# host 网络下的 MySQL/Redis 从 bridge 容器通过宿主机网关访问
MYSQL_HOST=172.17.0.1
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

REDIS_HOST=172.17.0.1
REDIS_PORT=6379
REDIS_USERNAME=root
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=0

JWT_SECRET=change-me-to-a-long-random-string
KNIFE4J_ENABLE=false
